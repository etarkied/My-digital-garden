{%if settings.dgHomeLink === true%}
    <nav class="navbar">
        <div class="navbar-inner">
            <a href="/" class="site-brand" title="{{meta.siteName}}">
                {% if meta.siteLogoPath %}
                    <img class="site-logo" src="{{meta.siteLogoPath}}" alt="" aria-hidden="true">
                {% endif %}
                <span class="site-wordmark">{{meta.siteName}}</span>
            </a>
        </div>
        <div class="navbar-actions">
            {% set slotName = "navbar.actions" %}{% include "components/pluginSlot.njk" %}
            {% include "components/pagePanelButton.njk" %}
        </div>
    </nav>
    {%else%}
    <div class="empty-navbar" >
        {% set slotName = "navbar.actions" %}{% include "components/pluginSlot.njk" %}
    </div>
{%endif%}
